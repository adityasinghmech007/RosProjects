<?xml version="1.0"?>
<robot xmlns:xacro = "http://www.ros.org/wiki/xacro">
    <xacro:property name="base_length" value="1.0"/>
    <xacro:property name="base_width" value="0.4"/>
    <xacro:property name="base_height" value="0.2"/>
    <xacro:property name="wheel_radius" value="0.1"/>
    <xacro:property name="wheel_length" value="0.05"/>
    <xacro:property name="castor_radius" value="0.05"/>

    <!-- <xacro:macro name="example_macro" params="a b c">
        <link name="dummy_link">
            <visual>
                <geometry>
                    <box size="${a} ${b} ${c}" />          
                </geometry>
            </visual>
        </link>
    </xacro:macro>

    <xacro:example_macro a="2" b="3" c="4"/> -->


    <link name="base_footprint" />
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
            <material name="green">
            </material>
        </visual>
    </link>

    <xacro:macro name="wheel_link" params="suffix">
        <link name="wheel_${suffix}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                <material name="grey">
                </material>
            </visual>
        </link>
    </xacro:macro>
    <xacro:wheel_link suffix="1" />
    <xacro:wheel_link suffix="2" />


    <link name="castorlink">
        <visual>
            <geometry>
                <sphere radius="${castor_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey">
            </material>
        </visual>
    </link>

    <joint name="my_robot_wheel1" type="continuous">
        <parent link="base_link" />
        <child link="wheel_1" />
        <origin xyz="${base_length /4.0} ${base_width /2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="100" />
    </joint>
    <joint name="my_robot_wheel2" type="continuous">
        <parent link="base_link" />
        <child link="wheel_2" />
        <origin xyz="${base_length /4.0} ${-base_width /2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="100" />
    </joint>
    <joint name="my_robot_castor_wheel" type="fixed">
        <parent link="base_link" />
        <child link="castorlink" />
        <origin xyz="${-base_width /2.0} 0 ${-castor_radius}"/>
    </joint>
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 -0.1" rpy="0 0 0" />
    </joint>

</robot>