<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="box_length" value="0.1" />
    <xacro:property name="box_width" value="0.1" />
    <xacro:property name="box_height" value="0.02" />
    <xacro:property name="forearm_radius" value="0.02" />
    <xacro:property name="forearm_height" value="0.3" />
    <xacro:property name="hand_radius" value="0.02" />
    <xacro:property name="hand_height" value="0.3" />


    <!-- <link name="base_link"/> -->


    <link name="arm_base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size= "${box_length} ${box_width} ${box_height}" />
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size= "${box_length} ${box_width} ${box_height}" />
            </geometry>
        </collision>
        <xacro:box_inertia m="0.5" x="${box_length}" y="${box_width}" z="${box_height}"
                           o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <link name="forearm_link">
        <visual>
            <geometry>
                <cylinder radius="${forearm_radius}" length="${forearm_height}" />
            </geometry>
            <origin xyz="0 0 ${(forearm_height/2)}" rpy="0 0 0" />
            <material name="yellow"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${(forearm_height/2)}" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${forearm_radius}" length="${forearm_height}" />
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.3" r="${forearm_radius}" l="${forearm_height}" 
                           o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <link name="hand_link">
        <visual>
            <origin xyz="0 0 ${hand_height/2}" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${hand_radius}" length="${hand_height}" />
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${hand_height/2}" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${hand_radius}" length="${hand_height}" />
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.3" r="${hand_radius}" l="${hand_height}" 
                           o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>


    <!-- <joint name="base_joint" type="fixed">
        <parent link="base_link" />
        <child link="arm_base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
     -->

    <joint name="arm_base_forearm_joint" type="revolute">
        <parent link="arm_base_link" />
        <child link="forearm_link" />
        <origin xyz="0 0 ${box_height}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="0" upper="${pi/2}" effort="100" velocity="100" />
        <dynamics friction="0.3" damping="0.3" />
    </joint>
    <joint name="forearm_hand_joint" type="revolute">
        <parent link="forearm_link" />
        <child link="hand_link" />
        <origin xyz="0 0 ${forearm_height}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="0" upper="${pi/2}" effort="100" velocity="100" />
        <dynamics friction="0.3" damping="0.3" />
    </joint>



</robot>