<?xml version="1.0"?>
<robot xmlns:xacro = "http://www.ros.org/wiki/xacro">
    <xacro:property name="base_length" value="0.6"/>
    <xacro:property name="base_width" value="0.4"/>
    <xacro:property name="base_height" value="0.2"/>
    <xacro:property name="wheel_radius" value="0.1"/>
    <xacro:property name="wheel_length" value="0.05"/>
    <xacro:property name="castor_radius" value="0.05"/>
    <link name="base_footprint" />
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
            <material name="green">
            </material>
            <collision>
                <geometry>
                    <box size="${base_length} ${base_width} ${base_height}"/>
                </geometry>
                <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
            </collision>
        </visual>
        <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}" 
                            o_xyz="0 0 ${base_height/2.0}" o_rpy="0 0 0"/>
    </link>

    <xacro:macro name="wheel_link" params="suffix">
        <link name="wheel_${suffix}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                <material name="grey">
                </material>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <xacro:cylinder_inertia m="1.0" x="${wheel_radius}" z="${wheel_length}" 
                            o_xyz="0 0 0" o_rpy="${pi/2.0} 0 0"/>

        </link>
    </xacro:macro>
    <xacro:wheel_link suffix="1" />
    <xacro:wheel_link suffix="2" />


    <link name="castorlink">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius/2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey">
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius/2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:sphere_inertia m="0.5" x="${wheel_radius/2}"  
                            o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </joint>

    <joint name="my_robot_wheel1" type="continuous">
        <parent link="base_link" />
        <child link="wheel_1" />
        <origin xyz="${base_length /4.0} ${(base_width + wheel_length) /2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="100" />
    </joint>
    <joint name="my_robot_wheel2" type="continuous">
        <parent link="base_link" />
        <child link="wheel_2" />
        <origin xyz="${base_length /4.0} ${-(base_width + wheel_length) /2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="100" />
    </joint>
    <joint name="my_robot_castor_wheel" type="fixed">
        <parent link="base_link" />
        <child link="castorlink" />
        <origin xyz="${-base_length /3.0} 0 ${-wheel_radius/2}"/>
    </joint>


</robot>
