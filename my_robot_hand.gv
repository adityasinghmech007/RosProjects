digraph G {
node [shape=box];
"base_link" [label="base_link"];
"arm_base_link" [label="arm_base_link"];
"forearm_link" [label="forearm_link"];
"hand_link" [label="hand_link"];
node [shape=ellipse, color=blue, fontcolor=blue];
"base_link" -> "base_joint" [label="xyz: 0 0 0 \nrpy: 0 -0 0"]
"base_joint" -> "arm_base_link"
"arm_base_link" -> "arm_base_forearm_joint" [label="xyz: 0 0 0.01 \nrpy: 0 -0 0"]
"arm_base_forearm_joint" -> "forearm_link"
"forearm_link" -> "forearm_hand_joint" [label="xyz: 0 0 0.3 \nrpy: 0 -0 0"]
"forearm_hand_joint" -> "hand_link"
}
